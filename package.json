{
  "name": "maria-reminds-us",
  "version": "3.0.0",
  "private": true,
  "description": "MariaRemindsUs - Mindful break reminders with gym, food, posture, sleep & water videos across all tabs.",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/wxt/bin/wxt.mjs",
    "build": "node ./node_modules/wxt/bin/wxt.mjs build",
    "build:edge": "node ./node_modules/wxt/bin/wxt.mjs build -b edge",
    "dev:firefox": "node ./node_modules/wxt/bin/wxt.mjs -b firefox",
    "build:firefox": "node ./node_modules/wxt/bin/wxt.mjs build -b firefox",
    "zip": "node ./node_modules/wxt/bin/wxt.mjs zip",
    "compile": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wxt": "^0.19.11"
  }
}
